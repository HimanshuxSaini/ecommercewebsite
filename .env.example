# ==============================================================================
# VELNEER ENTERPRISE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Security & Authentication Secrets
JWT_SECRET="velneer_super_secure_jwt_secret_key_2026_enterprise"
PAYMENT_WEBHOOK_SECRET="whsec_velneer_sandbox_secret_2026"

# ------------------------------------------------------------------------------
# 1. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Standard Connection String (Local development or MongoDB Atlas Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/velneer?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/velneer_store"

# ------------------------------------------------------------------------------
# 2. CLOUDINARY MEDIA & IMAGE ASSET STORAGE
# ------------------------------------------------------------------------------
# Sign up at https://cloudinary.com/ -> Dashboard to retrieve credentials:
CLOUDINARY_CLOUD_NAME="velneer-store"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# ------------------------------------------------------------------------------
# 3. BREVO TRANSACTIONAL EMAIL SERVICE (Formerly Sendinblue)
# ------------------------------------------------------------------------------
# Sign up at https://brevo.com/ -> SMTP & API Keys:
BREVO_API_KEY="your_brevo_v3_api_key_here"
BREVO_SENDER_EMAIL="sales.velneer@gmail.com"
BREVO_SENDER_NAME="Velneer Store"

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI & RUNTIME HOOKS
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
